datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id                    String        @id @default(uuid())
  business_name         String
  website               String?
  phone                 String?
  email                 String?
  city_country          String?
  niche_industry        String?
  rating                Float?
  review_count          Int?
  key_services          String?
  address               String?
  source_csv_row        String?       // JSON string
  priority              String?       // Hot, Hottest, Warm, Cold
  primary_observation   String?
  primary_offer         String?
  follow_up_count       Int           @default(0)
  reply_status          String?
  demo_link             String?
  pitch_type            String?       @default("redesign")
  pipeline_stage        Int           @default(1)
  status                String        @default("Imported")
  is_today_target       Boolean       @default(false)
  planned_for           DateTime?
  next_follow_up_at     DateTime?
  cleared_fields        String?       // JSON string
  converted_client_id   String?
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  contacts              Contact[]
  interactions          Interaction[]
  deals                 Deal[]
  proposals             Proposal[]
  workspaceItems        WorkspaceItem[]

  @@index([status])
  @@index([is_today_target])
  @@index([planned_for])
  @@index([next_follow_up_at])
  @@index([created_at])
  @@index([updated_at])
}

model Contact {
  id          String    @id @default(uuid())
  lead_id     String?
  client_id   String?
  name        String
  role        String?
  phone       String?
  email       String?
  whatsapp    String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  lead        Lead?     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  client      Client?   @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([lead_id])
  @@index([client_id])
}

model Interaction {
  id              String    @id @default(uuid())
  lead_id         String?
  client_id       String?
  channel         String
  direction       String
  content         String
  confirmed_sent  Boolean   @default(false)
  sent_confirmed_at DateTime?
  created_at      DateTime  @default(now())

  lead            Lead?     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  client          Client?   @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([lead_id])
  @@index([client_id])
}

model Task {
  id                    String    @id @default(uuid())
  related_type          String
  related_id            String
  type                  String
  title                 String
  due_date              DateTime?
  status                String    @default("Open")
  bucket                String    @default("Follow-up")
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([related_id])
  @@index([bucket])
  @@index([status])
}

model Deal {
  id          String    @id @default(uuid())
  lead_id     String
  stage       String    @default("Booking")
  value       Float?
  lost_reason String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  lead        Lead      @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id])
  @@index([stage])
}

model Client {
  id              String        @id @default(uuid())
  lead_id         String?       @unique
  business_name   String
  primary_contact String?
  email           String?
  phone           String?
  stage           String        @default("Proposal")
  payment_status  String        @default("Pending")
  last_activity   DateTime      @default(now())
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  contacts        Contact[]
  interactions    Interaction[]
  proposals       Proposal[]
  invoices        Invoice[]
  onboarding      Onboarding?

  @@index([stage])
  @@index([payment_status])
}

model Proposal {
  id                  String    @id @default(uuid())
  lead_id             String?
  client_id           String?
  services            String?   // JSON string
  scope               String?
  deliverables        String?
  timeline            String?
  terms               String?
  currency            String    @default("AED")
  total_investment    Float     @default(0)
  document_url        String?
  status              String    @default("Draft")
  approved_at         DateTime?
  sent_confirmed_at   DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  lead                Lead?     @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  client              Client?   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  invoices            Invoice[]

  @@index([lead_id])
  @@index([client_id])
  @@index([status])
}

model Invoice {
  id                    String    @id @default(uuid())
  client_id             String
  proposal_id           String?
  invoice_number        String    @unique
  currency              String    @default("AED")
  line_items            String?   // JSON string
  amount                Float     @default(0)
  due_date              DateTime
  payment_instructions  String?
  payment_method        String?   @default("sadapay")
  payment_method_note   String?
  notes                 String?
  status                String    @default("Draft")
  milestone_label       String?
  milestone_index       Int?
  milestone_percent     Int?
  sent_confirmed_at     DateTime?
  paid_confirmed_at     DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  client                Client    @relation(fields: [client_id], references: [id], onDelete: Cascade)
  proposal              Proposal? @relation(fields: [proposal_id], references: [id], onDelete: SetNull)

  @@index([client_id])
  @@index([proposal_id])
  @@index([status])
}

model Onboarding {
  id            String    @id @default(uuid())
  client_id     String    @unique
  checklist     String?   // JSON string
  status        String    @default("In Progress")
  started_at    DateTime  @default(now())
  completed_at  DateTime?

  client        Client    @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id])
  @@index([status])
}

model Document {
  id            String    @id @default(uuid())
  related_type  String
  related_id    String
  type          String
  title         String
  file_url      String
  created_at    DateTime  @default(now())

  @@index([related_id])
  @@index([related_type])
}

model Settings {
  id                      String   @id @default("default")
  daily_target_quota      Int      @default(5)
  follow_up_cadence_days  Int      @default(4)
  tone_preference         String   @default("Professional, concise, and value-oriented")
  theme_preference        String   @default("dark")
  message_templates       String?  // JSON string
  proposal_templates      String?  // JSON string
  invoice_branding        String?  // JSON string
  updated_at              DateTime @updatedAt
}

model CsvMappingTemplate {
  id                String   @id @default(uuid())
  header_signature  String   @unique
  template_name     String   @default("Saved Mapping")
  field_mappings    String   // JSON string
  last_used_at      DateTime @default(now())
  created_at        DateTime @default(now())

  @@index([header_signature])
}

model WorkspaceItem {
  id            String            @id @default(cuid())
  leadId        String
  lead          Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type          String
  title         String?
  content       String?

  url           String?
  provider      String?

  fileKey       String?
  mimeType      String?
  fileSizeBytes Int?

  isPinned      Boolean           @default(false)
  sortOrder     Int               @default(0)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([leadId, type])
}

model Snippet {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("General")
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}
