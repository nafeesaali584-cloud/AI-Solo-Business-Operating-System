# ==============================================================================
# ClientPulse — Production Environment Variables Reference (.env.example)
# Set these variables in Hostinger's Environment Variables panel before deploying.
# NEVER commit your actual .env or .env.local file to GitHub or version control.
# ==============================================================================

# 1. PRIMARY DATABASE CONNECTION (Neon / Supabase PostgreSQL)
# Get from: Neon Dashboard (Connection Details) or Supabase (Project Settings -> Database -> Connection Pooling URI)
# Format: postgresql://[user]:[password]@[host]:6543/postgres?pgbouncer=true (or direct 5432 if using Neon)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT DATABASE CONNECTION (For Prisma schema push / migrations)
# Get from: Supabase (Project Settings -> Database -> Direct Connection URI on port 5432) or identical to DATABASE_URL if using Neon
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 3. GOOGLE GEMINI AI API KEY (Powers Deep Research, Smart Outreach & Copilot)
# Get from: Google AI Studio -> "Get API Key" (https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 4. GEMINI MODEL OVERRIDE (Optional)
# Default is "gemini-3.5-flash-lite" or "gemini-2.5-flash". Leave unset to use default.
GEMINI_MODEL="gemini-3.5-flash-lite"

# 5. SESSION SECURITY SECRET
# Generate by: Run `openssl rand -hex 32` in terminal or create a random 32+ character alphanumeric string
SESSION_SECRET="replace-with-a-random-32-character-secret-string-here"

# 6. PUBLIC APPLICATION CANONICAL URL
# Set to: Your live Hostinger production domain (e.g., https://clientpulse.yourdomain.com or https://yourdomain.com)
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# 7. NODE ENVIRONMENT
# Set to: production
NODE_ENV="production"

# 8. SOLO-ADMIN CREDENTIALS (Authentication & Access Control)
# Used to sign into your ClientPulse OS. Change these to your own private credentials!
ADMIN_EMAIL="admin@clientpulse.io"
ADMIN_PASSWORD="YourSecurePasswordHere2026!"
